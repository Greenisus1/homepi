# Home Pi 1.0.0 for Raspberry Pi 5 (aarch64, BCM2712)
# Layered on Buildroot's raspberrypi5_defconfig; see README.md for the build.
BR2_aarch64=y
BR2_cortex_a76=y

# External Bootlin toolchain: no from-scratch gcc build, much lighter.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_SYSTEM_DHCP="eth0"

# Home Pi branding
BR2_TARGET_GENERIC_HOSTNAME="homepi"
BR2_TARGET_GENERIC_ISSUE="Home Pi \\n \\l"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HOMEPI_PATH)/board/homepi/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/raspberrypi5/post-build.sh $(BR2_EXTERNAL_HOMEPI_PATH)/board/homepi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/raspberrypi5/post-image.sh"

# Kernel: pinned raspberrypi/linux tarball (same as upstream rpi5 defconfig).
# To build from the local clone instead (the local kernel clone):
# replace the two CUSTOM_TARBALL lines with
#   BR2_LINUX_KERNEL_CUSTOM_LOCAL=y
#   BR2_LINUX_KERNEL_CUSTOM_LOCAL_PATH="$(HOMEPI_KERNEL_PATH)"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="board/raspberrypi5/config_5.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="board/raspberrypi5/cmdline_5.txt"
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Home Pi needs python3 + curses for the launcher and the App Store apps.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_CURSES=y
# SSH access from his Mac on first boot.
BR2_PACKAGE_DROPBEAR=y
# Boot splash: framebuffer image viewer for the WinnieGaming logo screen.
BR2_PACKAGE_FBV=y
# Wi-Fi for the first-boot network step (Pi 5 wireless).
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_IW=y
# git for hpbackup (GitHub backup pushes).
BR2_PACKAGE_GIT=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
